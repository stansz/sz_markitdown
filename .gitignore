# TypeScript emit for the node-side config project (see tsconfig.node.json).
# These are compiled artifacts of vite.config.ts — never commit them: Vite
# resolves vite.config.js BEFORE vite.config.ts, so a committed .js silently
# shadows edits to the .ts.
vite.config.js
vite.config.d.ts
